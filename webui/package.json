{
  "name": "webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --experimental-strip-types src/server/index.ts",
    "build:spa": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "npm run build:spa && npm run build:api",
    "start": "node build/server/index.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/server/*.test.ts vite.config.test.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.58",
    "@ag-ui/core": "^0.0.58",
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
