FOUNDRY_AGENT_ENDPOINT=https://your-foundry-endpoint/responses
FOUNDRY_AGENT_API_KEY=
FOUNDRY_AUTH_MODE=bearer
FOUNDRY_AGENT_NAME=digibuddy-codex
FOUNDRY_AGENT_VERSION=2
CODEX_MODEL_NAME=gpt-5.6-sol
AGENT_ENDPOINT_ALLOWLIST=services.ai.azure.com,openai.azure.com

# Optional: accept native members of one Entra tenant plus explicitly trusted
# corporate B2B accounts. The app registration must emit `acct` and `upn`.
AUTH_PROVIDERS=aad
AUTH_REQUIRE_CORPORATE_ACCOUNT=false
# One tenant, or a comma-separated set when several are trusted.
AUTH_TENANT_ID=
AUTH_ALLOWED_UPN_DOMAINS=
# Trusted B2B home tenants and their verified work-email domains.
AUTH_ALLOWED_HOME_TENANT_IDS=
AUTH_ALLOWED_EMAIL_DOMAINS=

# Shared runtime configuration store. Set exactly one, and point the hosted
# agent at the same location so admin changes reach it.
DIGIBUDDY_CONFIG_URI=https://yourstorage.blob.core.windows.net/digibuddy-config
# DIGIBUDDY_CONFIG_DIR=/var/lib/digibuddy/config
# Hosted-agent config proxy; agents call this instead of private storage.
DIGIBUDDY_CONFIG_API=https://your-console-host/api/runtime
# Entra scope requested by the agent and audience accepted by the runtime API.
DIGIBUDDY_CONFIG_API_SCOPE=api://your-console-app-id/.default
# Hosted-agent config proxy secret; at least 32 characters, delivered out of band.
DIGIBUDDY_CONFIG_API_SECRET=
# Managed identity object IDs allowed to call /api/runtime through Entra.
DIGIBUDDY_RUNTIME_PRINCIPAL_IDS=
# Runtime API shared secret; at least 32 characters, delivered out of band.
DIGIBUDDY_RUNTIME_SHARED_SECRET=

# Agent profile used when a chat user does not pick one.
# DIGIBUDDY_PROFILE=digibuddy

# Comma-separated Entra object IDs or sign-in names allowed to use /admin.
# The console expects Easy Auth in front of it, supplying x-ms-client-principal.
# An empty list denies everyone.
ADMIN_PRINCIPAL_IDS=

# Optional dedicated /admin login. When all three values are set, this takes
# precedence over ADMIN_PRINCIPAL_IDS. Hash format:
# scrypt$16384$8$1$<base64url-salt>$<base64url-derived-key>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local development only; ignored when NODE_ENV=production.
# ADMIN_ALLOW_ANONYMOUS=true
