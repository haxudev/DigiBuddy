{
  "event_id": "evt-<32 lowercase hex>",
  "previous_event_sha256": "none | sha256:<64 lowercase hex>",
  "event_sha256": "sha256:<64 lowercase hex of this event excluding event_sha256>",
  "type": "candidate-created | source-added | proposal-created | initialization-proposal | approved | rejected | prepared | applied | aborted | rollback-prepared | rolled-back | rollback-aborted",
  "at": "<ISO-8601 timestamp>",
  "profile_id": "<profile-id>",
  "candidate_id": "cand-<32 lowercase hex>",
  "references_event_id": "evt-<prepared/applied event id, or none>",
  "payload": {
    "target": "pitfall | acceptance | skeleton | needs-dimension-change",
    "lesson": "<domain lesson; candidate-created only>",
    "applies_when": "<condition; candidate-created only>",
    "source": {
      "project_id": "<opaque project identity>",
      "task_slug": "<slug>",
      "plan_revision": 1,
      "report_finalized_at": "<ISO-8601 timestamp>",
      "report_sha256": "sha256:<64 lowercase hex>",
      "report_candidate_id": "L1",
      "source_ref": "<user-global HMAC-SHA-256, or none for project events>"
    },
    "reason": "<approval, rejection, or rollback reason>",
    "approval_id": "<user approval event id>",
    "scope": "project | user",
    "base_sha256": "sha256:<64 lowercase hex> | none",
    "result_sha256": "sha256:<64 lowercase hex>",
    "target_path": "<canonical profile path>",
    "approved_diff": "<exact diff shown to the user>",
    "before_content": "<exact prior profile content, or empty>",
    "after_content": "<exact approved profile content>"
  }
}
